{
  "name": "evidence-mcp",
  "version": "1.1.0",
  "description": "Power tools for AI agents to improve and speed up medical literature research",
  "type": "module",
  "bin": {
    "evidence-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "browser": "playwright-core install chromium",
    "build": "node scripts/gen-prompts.mjs && tsup src/index.ts --format esm --target node18 --clean --no-splitting",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node scripts/gen-prompts.mjs && FH_EVIDENCE_DIR=$(mktemp -d) tsx --test test/*.test.ts",
    "tui": "bash tui/run.sh"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fast-xml-parser": "^5.11.2",
    "playwright-core": "1.65.0",
    "turndown": "^7.2.4",
    "undici": "^7.30.2",
    "unpdf": "^1.9.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "mcp",
    "ai4l",
    "pubmed",
    "papers",
    "library",
    "evidence-review"
  ],
  "author": "Forever Healthy Foundation",
  "license": "MIT",
  "homepage": "https://github.com/forever-healthy/evidence-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/forever-healthy/evidence-mcp.git"
  }
}
