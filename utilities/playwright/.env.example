# Where the browser server is published. 127.0.0.1 when the MCP server runs on
# this host; on a residential host the tailnet IP (never 0.0.0.0 — no auth).
BIND_IP=127.0.0.1
PORT=8932
# Each connected MCP server (worker) gets its own Chromium, ~300–400 MB headed,
# released after 120 s idle. Size for the concurrent workers: 4g ≈ 6–8.
MEM_LIMIT=4g
