# evidence-mcp — the whole configuration. Copy to .env and fill in what you use.
#
# Loaded at startup from the working directory (the project root), or the file
# FH_ENV names, or .env in the library directory. Precedence: the
# environment, then this file, then the built-in default. Every value the
# library reads is listed here; the lines commented out show their defaults.
# Every key the library reads is an FH_* variable, including the ones
# other MCP servers also need (NCBI, Bright Data): a deployment that still runs
# those servers carries such a key twice, bare for them, prefixed for the library.

# ---- Location --------------------------------------------------------------
# The library: evidence/ under the working directory, or /evidence when that
# exists (a mounted volume).

#FH_EVIDENCE_DIR=

# The log: <library>/logs/evidence.log, rotated at 5 MB into dated files; rotated
# logs older than this many days are deleted.

#FH_LOG_KEEP_DAYS=7

# The client: the name this server writes into every log line (default: the
# host name) — set one per project when several share a library on one machine;
# and whether the log viewer shows that column.

#FH_CLIENT_NAME=
#FH_CLIENT_SHOW=false

# ---- Contact ---------------------------------------------------------------
# Sent to every service as the contact: NCBI tool/email, Unpaywall and OpenAlex
# polite pools, Crossref, the User-Agent. Default: hello@forever-healthy.org.

FH_CONTACT_EMAIL=

# ---- NCBI ------------------------------------------------------------------
# Optional. E-utilities: 10 requests per second instead of 3.
# Get one: NCBI account → Account settings → API Key Management. Account creation
#   is blocked outside the US (403 on "Continue"); sign up through a US VPN once.
#   https://account.ncbi.nlm.nih.gov/settings/

FH_NCBI_API_KEY=

# ---- Web search ------------------------------------------------------------
# Optional. fh_web_search is offered to the agent when at least one provider key
# is set; without one the agent uses its model's own web search. Every provider
# with a key takes part: they are queried in parallel and their results merged.
# Searches are cached for FH_SEARCH_CACHE_DAYS.

# Exa — a key from https://dashboard.exa.ai
#FH_WEB_SEARCH_EXA_API_KEY=

# Serper (Google results) — a key from https://serper.dev
#FH_WEB_SEARCH_SERPER_API_KEY=

# Brave — a key from https://brave.com/search/api
#FH_WEB_SEARCH_BRAVE_API_KEY=

# Snippets: on (default), a short passage from each page, the one matching the
# query; off, links only.

#FH_WEB_SEARCH_SNIPPETS=on

# Timeout: how long one provider may take (seconds); past it the search answers
# with the others' results.

#FH_WEB_SEARCH_TIMEOUT_SECS=10

# ---- Full-text sources ------------------------------------------------------
# Which full-text sources run, in this order; a source not listed is off.
# Unset: every source in the built-in order (proxy last, when its URL is set).

#FH_SOURCES=pmc,europepmc,tdm,unpaywall,openalex,core,doi-link,proxy

# ---- TDM Tiers -----------------------------------------------------------------
# The publishers' text-and-data-mining links, for open-access and
# entitled articles.
# Elsevier (only works for accounts of a subscribing institution; a personal key
# gets AUTHENTICATION_ERROR for everything):  https://dev.elsevier.com/apikey/manage
# Wiley (free):              https://static.wiley.com/tdm/

FH_ELSEVIER_API_KEY=
FH_WILEY_TDM_TOKEN=

# ---- CORE Tier -----------------------------------------------------------------
# CORE (core.ac.uk), the aggregator of open-access repository
# copies, by DOI; skipped without a key.
# Free key: https://core.ac.uk/services/api → "Get API key"

FH_CORE_API_KEY=

# ---- OpenAlex Tier -------------------------------------------------------------
# OpenAlex (openalex.org) is a tier and looks up abstracts by DOI. Optional: a
# free key raises the daily allowance; without one it works as well.
# OpenAlex is also where fh_citing_articles gets a paper's citations.
# Free key: https://openalex.org/settings/api

FH_OPENALEX_API_KEY=

# ---- Proxy tier ------------------------------------------------------------
# One proxy: an institutional proxy, a licensed service, a local mirror. A URL
# template with {doi} {pmid} {pmcid} (each URL-encoded when filled), e.g. just
# the DOI in the URL. Unset URL = no proxy tier. The service answers a PDF or
# XML; anything else is recorded as its error message.

#FH_PROXY_URL=https://papers.example.org/{doi}

# Only if the service wants credentials: request headers as "Name: value; Name: value".
#FH_PROXY_HEADERS=Authorization: Bearer <token>

# ---- Download cascade ------------------------------------------------------
# Three stages, each only when the one before got no valid result (a PDF or
# the article). Within a stage all requests run at once; the first valid one
# wins. A 404 or 410 ends the download. All but the plain fetch are optional.
#
#   1 fetch      plain fetch, fetch proxy
#   2 browsers   Playwright servers, Chrome     on a 403, 429, or bot wall
#   3 unlockers  ZenRows, Zyte, Bright Data     paid
#
# Values: host or host:port.

# ---- Stage 1: fetch --------------------------------------------------------
# Optional fetch proxy: the same request from another host's IP, best a
# residential line. utilities/fetch-proxy/ (port 8888, tailnet only).

#FH_FETCH_PROXY=

# ---- Stage 2: browsers (optional) ------------------------------------------
# Playwright server: utilities/playwright/ (port 8932, headed under Xvfb). Must
# run the package's playwright-core version (fh_info → download.playwright.version).
# Headless: auto (= headed), true, false.

#FH_PLAYWRIGHT_1=playwright.example.org
#FH_PLAYWRIGHT_2=
#FH_PLAYWRIGHT_HEADLESS=auto

# Chrome: a real desktop Chrome with remote debugging (port 9222).
# utilities/chrome/chrome.md.

#FH_CHROME_1=127.0.0.1
#FH_CHROME_2=

# ---- Stage 3: unlockers (optional) -----------------------------------------
# Every unlocker with a key takes part. A request already sent is billed even
# when its answer is not used.
#
# Firecrawl (subscription, free tier): key from https://www.firecrawl.dev/app
# ZenRows (subscription): key from https://app.zenrows.com
# Zyte (pay-per-use): key from https://app.zyte.com
# Bright Data (pay-per-use): API token from Account settings → API tokens.

#FH_FIRECRAWL_API_KEY=
#FH_ZENROWS_API_KEY=
#FH_ZYTE_API_KEY=
#FH_BRIGHTDATA_API_KEY=

# Bright Data zone: your Web Unlocker zone (default mcp_unlocker).

#FH_BRIGHTDATA_ZONE=mcp_unlocker

# ---- Retry and refresh -----------------------------------------------------
# Days before a transient tier failure (timeout, 403, wall page) is retried;
# whether a browser challenge not cleared or a Bright Data refusal counts as
# transient too (only after a change of method); days after which an entry's
# PubMed record is re-read for correction notices and retractions. The retry
# cooldown also holds a page fh_fetch_url could not get, and an ID no service
# knew (not found): answered from disk until then, asked again after. Days a
# registry or PubMed search is cached before it is run again.

#FH_RETRY_AFTER_DAYS=1
#FH_RETRY_BLOCKED=false
#FH_REFRESH_AFTER_DAYS=30
#FH_SEARCH_CACHE_DAYS=7

# ---- Verify ----------------------------------------------------------------
# fh_verify_claim's decision model.
#
# PROVIDER  the API the server speaks: perplexity | google | openai | liquid
# URL       empty: the provider's hosted endpoint
# MODEL     empty: the provider's default
# API_KEY   empty: for a key-less server
#
# Perplexity — hosted: a key from console.perplexity.ai; the default model is
# pplx-decider-flash-v1.2, pplx-decider-v1.2 the 27B model.
#
# Perplexity — Decider for Mac: URL http://<its IP>:8080, no key, it serves
# pplx-decider-flash-v1.2 only.
#
# Google Gemini Decision: the default model is gemini-decision-1. Key from
# https://aistudio.google.com/apikey. Free tier: 50,000 input tokens per minute,
# about one or two full-text papers a minute; over it the server waits as Google
# asks (at most 60 s, twice) and a paper larger than the limit fails.
#
# OpenAI Decisions API: the model is gpt-6-luna, the only one it serves. Key
# from https://platform.openai.com/api-keys.
#
# Liquid AI decision models: the default model is d1-ultra, d1.1 the faster one.
# Key from https://console.liquid.ai.

FH_VERIFY_PROVIDER=
FH_VERIFY_URL=
FH_VERIFY_MODEL=
FH_VERIFY_API_KEY=

# Threshold: the probability at or above which a paper counts as stating the
# claim; timeout per request; both for every provider.

#FH_VERIFY_THRESHOLD=0.5
#FH_VERIFY_TIMEOUT_SECS=60

# ---- TUI (tui/ctl.py, not part of the package) -----------------------------
# How often the library is rescanned (seconds); a port for GET /status on
# 0.0.0.0 (0 = none; for a dashboard or monitor); whether each rescan starts
# with a git pull of the checkout (1 = on, for a TUI running unattended from a
# clone); how long a log "!!" alert stays a /status problem without a repeat.

#FH_TUI_STATUS_SECS=60
#FH_TUI_PORT=0
#FH_TUI_PULL=0
#FH_TUI_ALERT_HOURS=24

# ---- Deployment (utilities/deploy.sh) --------------------------------------
# utilities/deploy.sh up|down|status deploys the fetch proxy and the Playwright
# servers as Docker containers on the FH_FETCH_PROXY and FH_PLAYWRIGHT_n
# hosts, and Chrome as a user service on the FH_CHROME_n hosts — every configured stage, locally or over SSH.
# See utilities/README.md.

#FH_DEPLOY_CONTAINER_PREFIX=       # e.g. evidence-: own names for containers, projects, images, Chrome services (each ends in its port)

# Per stage, named like FH_FETCH_PROXY / FH_PLAYWRIGHT_n / FH_CHROME_n. Every configured stage is
# deployed; there is no deploy flag.

#FH_DEPLOY_FETCH_PROXY_USER=       # SSH user (else ~/.ssh/config)
#FH_DEPLOY_FETCH_PROXY_MEM=128m    # memory limit
#FH_DEPLOY_FETCH_PROXY_BIND=       # publish on this IP instead of the tailnet IP

#FH_DEPLOY_PLAYWRIGHT_1_USER=
#FH_DEPLOY_PLAYWRIGHT_1_MEM=4g
#FH_DEPLOY_PLAYWRIGHT_1_BIND=

#FH_DEPLOY_PLAYWRIGHT_2_USER=
#FH_DEPLOY_PLAYWRIGHT_2_MEM=4g
#FH_DEPLOY_PLAYWRIGHT_2_BIND=

#FH_DEPLOY_CHROME_1_USER=
